<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#E9E7DF">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Atelier Stock">
<title>Atelier Stock</title>
<style>
  :root{
    --paper:#E9E7DF;
    --card:#FCFBF6;
    --ink:#1A1915;
    --ink-soft:#57544B;
    --line:#CFCCC0;
    --line-strong:#1A1915;
    --spot:#D6461E;        /* sortie / transformation */
    --teal:#0E6E62;        /* entrée / nouveau stock  */
    --amber:#9A5B12;       /* à reporter */
    --green:#2F6B33;       /* reporté */
    --shadow:0 1px 0 rgba(26,25,21,.06), 0 2px 10px rgba(26,25,21,.05);
    --mono:ui-monospace,"SF Mono","Roboto Mono",Menlo,monospace;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{
    background:var(--paper);color:var(--ink);font-family:var(--sans);
    line-height:1.45;-webkit-font-smoothing:antialiased;
    padding-bottom:calc(78px + env(safe-area-inset-bottom));
  }
  .wrap{max-width:520px;margin:0 auto;min-height:100vh}

  /* Header */
  header{
    padding:calc(env(safe-area-inset-top) + 16px) 20px 14px;
    border-bottom:2px solid var(--line-strong);background:var(--paper);
    position:sticky;top:0;z-index:20;
  }
  .brand{display:flex;align-items:center;gap:10px}
  .drop{width:16px;height:16px;background:var(--spot);border-radius:50% 50% 50% 2px;transform:rotate(45deg)}
  .brand h1{
    font-size:20px;margin:0;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
    font-stretch:condensed;
  }
  .brand .sub{font-size:11px;color:var(--ink-soft);letter-spacing:.14em;text-transform:uppercase;margin-top:2px}
  .brand-txt{line-height:1.05}

  /* Views */
  main{padding:18px 16px 30px}
  .view{display:none}
  .view.active{display:block}
  .step{margin-bottom:22px}
  .step-label{
    display:flex;align-items:baseline;gap:8px;margin:0 0 10px;
    font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);font-weight:700;
  }
  .step-num{font-family:var(--mono);color:var(--spot);font-weight:700}

  /* Selectable buttons */
  .grid{display:flex;flex-wrap:wrap;gap:8px}
  .opt{
    appearance:none;border:1.5px solid var(--line);background:var(--card);color:var(--ink);
    padding:12px 14px;border-radius:10px;font-family:var(--sans);font-size:15px;font-weight:600;
    min-height:46px;min-width:46px;cursor:pointer;transition:transform .04s ease;flex:0 0 auto;
  }
  .opt:active{transform:scale(.96)}
  .opt.sel{background:var(--ink);color:var(--card);border-color:var(--ink)}
  .opt.spot.sel{background:var(--spot);border-color:var(--spot)}
  .opt.wide{flex:1 1 30%;text-align:center}
  .opt .g{font-family:var(--mono);font-size:13px;opacity:.7;margin-left:2px}
  .opt.sel .g{opacity:.85}

  /* Quantity stepper */
  .qty{display:flex;align-items:center;gap:0;width:fit-content;border:1.5px solid var(--line-strong);border-radius:12px;overflow:hidden}
  .qty button{
    width:56px;height:52px;border:none;background:var(--card);font-size:26px;color:var(--ink);cursor:pointer;font-weight:600;
  }
  .qty button:active{background:#efece3}
  .qty .val{width:66px;text-align:center;font-family:var(--mono);font-size:22px;font-weight:700;border-left:1.5px solid var(--line);border-right:1.5px solid var(--line);line-height:52px}

  .soft-note{text-transform:none;letter-spacing:0;font-weight:500;color:var(--ink-soft)}
  .sizeqty{display:flex;flex-direction:column;gap:8px;margin-top:12px}
  .sizeqty .row{display:flex;align-items:center;gap:12px;background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:8px 10px}
  .sizeqty .row .sz{font-family:var(--mono);font-weight:700;font-size:16px;min-width:46px}
  .sizeqty .row .mini{display:flex;align-items:center;margin-left:auto;border:1.5px solid var(--line-strong);border-radius:10px;overflow:hidden}
  .sizeqty .row .mini button{width:44px;height:42px;border:none;background:var(--card);font-size:22px;font-weight:600;cursor:pointer;color:var(--ink)}
  .sizeqty .row .mini button:active{background:#efece3}
  .sizeqty .row .mini .v{width:48px;text-align:center;font-family:var(--mono);font-weight:700;font-size:18px;line-height:42px;border-left:1.5px solid var(--line);border-right:1.5px solid var(--line)}
  .sizeqty .row .rm{border:none;background:none;color:var(--spot);font-size:22px;cursor:pointer;padding:2px 6px;line-height:1}

  /* Modal / bottom sheet */
  .overlay{position:fixed;inset:0;background:rgba(20,19,15,.45);z-index:60;display:none;align-items:flex-end;justify-content:center}
  .overlay.show{display:flex}
  .sheet{background:var(--paper);width:100%;max-width:520px;max-height:92vh;overflow-y:auto;border-radius:18px 18px 0 0;border-top:2px solid var(--line-strong);padding:20px 16px calc(20px + env(safe-area-inset-bottom));animation:up .2s ease}
  @keyframes up{from{transform:translateY(30px)}to{transform:none}}
  .sheet h2{font-size:15px;letter-spacing:.1em;text-transform:uppercase;margin:0 0 4px;font-weight:800}
  .sheet .sub2{font-size:12px;color:var(--ink-soft);margin:0 0 16px}
  .sheet .step{margin-bottom:16px}
  .sheet-actions{display:flex;gap:10px;margin-top:8px}

  input[type=text]{
    width:100%;border:1.5px solid var(--line);background:var(--card);border-radius:10px;
    padding:13px 14px;font-size:16px;font-family:var(--sans);color:var(--ink);
  }
  input[type=text]:focus{outline:none;border-color:var(--ink)}
  .hint{font-size:12px;color:var(--ink-soft);margin-top:6px}

  /* Job ticket preview */
  .ticket{
    background:var(--card);border:1.5px solid var(--line-strong);border-radius:12px;
    padding:14px 16px 14px 20px;position:relative;box-shadow:var(--shadow);margin-top:8px;
  }
  .ticket::before{
    content:"";position:absolute;left:8px;top:10px;bottom:10px;width:0;
    border-left:2px dashed var(--line);
  }
  .ticket .code{font-family:var(--mono);font-size:13px;color:var(--ink-soft);letter-spacing:.02em;word-break:break-word}
  .mv{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:14px}
  .mv .sign{font-family:var(--mono);font-weight:700;font-size:15px;flex:0 0 auto}
  .mv.out .sign{color:var(--spot)}
  .mv.in .sign{color:var(--teal)}
  .mv .lbl{font-weight:600;line-height:1.3}
  .mv .lbl small{display:block;font-weight:500;color:var(--ink-soft);font-family:var(--mono);font-size:12px}

  /* Primary action */
  .cta{
    display:block;width:100%;margin-top:20px;padding:16px;border:none;border-radius:12px;
    background:var(--spot);color:#fff;font-size:16px;font-weight:700;letter-spacing:.02em;cursor:pointer;
    box-shadow:0 2px 0 #a8340f;
  }
  .cta:active{transform:translateY(1px);box-shadow:0 1px 0 #a8340f}
  .cta:disabled{background:#c9c6bc;color:#8a887f;box-shadow:none;cursor:not-allowed}

  /* History */
  .day-h{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);font-weight:700;margin:18px 2px 8px}
  .hist{background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px;position:relative}
  .hist .top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
  .hist .main-lbl{font-weight:700;font-size:15px}
  .hist .code{font-family:var(--mono);font-size:12px;color:var(--ink-soft);margin-top:3px}
  .pill{font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:4px 8px;border-radius:20px;white-space:nowrap;flex:0 0 auto}
  .pill.pending{background:#f6ecd9;color:var(--amber)}
  .pill.partial{background:#e2e7ef;color:#3a4a63}
  .pill.synced{background:#e2efe1;color:var(--green)}
  .mv-state{font-family:var(--mono);font-size:12px;color:var(--ink-soft);margin-top:8px}
  .mv-state .ok{color:var(--green);font-weight:700}
  .hist .foot{display:flex;justify-content:space-between;align-items:center;margin-top:10px}
  .hist .moves{font-family:var(--mono);font-size:13px}
  .hist .moves .o{color:var(--spot);font-weight:700}
  .hist .moves .i{color:var(--teal);font-weight:700}
  .lnk{background:none;border:none;color:var(--ink-soft);font-size:13px;text-decoration:underline;cursor:pointer;padding:6px 2px}
  .lnk.del{color:var(--spot)}

  /* Shopify recap */
  .sec{margin-bottom:24px}
  .sec-h{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin-bottom:10px}
  .sec-h .tag{font-family:var(--mono);font-size:12px;padding:2px 7px;border-radius:6px;color:#fff}
  .sec.out .tag{background:var(--spot)}
  .sec.in .tag{background:var(--teal)}
  .recap-line{background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;cursor:pointer;min-height:58px}
  .recap-line:active{transform:scale(.995)}
  .recap-line .num{margin-left:auto}
  .recap-line .check{width:26px;height:26px;border:2px solid var(--line-strong);border-radius:7px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;transition:.15s;background:var(--paper)}
  .recap-line.done .check{background:var(--green);border-color:var(--green)}
  .recap-line.done .check::after{content:"✓";color:#fff;font-size:16px;font-weight:800;line-height:1}
  .recap-line.done .lbl{text-decoration:line-through;opacity:.5}
  .recap-line.done .num{opacity:.4}
  .recap-line .lbl{font-weight:600;font-size:14px}
  .recap-line .lbl small{display:block;font-family:var(--mono);font-size:12px;color:var(--ink-soft);font-weight:500;margin-top:2px}
  .recap-line .num{font-family:var(--mono);font-weight:800;font-size:18px;flex:0 0 auto}
  .sec.out .num{color:var(--spot)}
  .sec.in .num{color:var(--teal)}
  .recap-actions{display:flex;gap:10px;margin-top:6px}
  .btn2{flex:1;padding:14px;border-radius:11px;border:1.5px solid var(--line-strong);background:var(--card);font-weight:700;font-size:14px;cursor:pointer;color:var(--ink)}
  .btn2.solid{background:var(--ink);color:var(--card);border-color:var(--ink)}
  .btn2:active{transform:translateY(1px)}

  /* Settings */
  .set-block{background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:14px;margin-bottom:14px}
  .set-block h3{margin:0 0 12px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft)}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
  .chip{display:inline-flex;align-items:center;gap:6px;background:var(--paper);border:1.5px solid var(--line);border-radius:20px;padding:7px 10px 7px 12px;font-size:14px;font-weight:600}
  .chip button{border:none;background:none;color:var(--spot);font-size:16px;cursor:pointer;line-height:1;padding:0 2px}
  .addrow{display:flex;gap:8px}
  .addrow input{flex:1}
  .addrow button{padding:0 16px;border:1.5px solid var(--line-strong);background:var(--ink);color:var(--card);border-radius:10px;font-weight:700;cursor:pointer}
  .size-row{margin-bottom:12px}
  .size-row label{display:block;font-family:var(--mono);font-weight:700;font-size:13px;margin-bottom:5px}
  .danger{color:var(--spot);font-weight:700;background:none;border:1.5px solid var(--spot);border-radius:10px;padding:11px;width:100%;cursor:pointer;font-size:14px}

  .empty{text-align:center;color:var(--ink-soft);padding:40px 20px;font-size:15px}
  .empty .big{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:6px}

  /* Bottom nav */
  nav{
    position:fixed;bottom:0;left:0;right:0;z-index:30;background:var(--card);
    border-top:2px solid var(--line-strong);
    padding:8px 6px calc(8px + env(safe-area-inset-bottom));
    display:flex;max-width:520px;margin:0 auto;
  }
  nav button{
    flex:1;border:none;background:none;display:flex;flex-direction:column;align-items:center;gap:3px;
    color:var(--ink-soft);font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;
    padding:4px 2px;position:relative;
  }
  nav button svg{width:23px;height:23px;stroke:var(--ink-soft);fill:none;stroke-width:1.8}
  nav button.on{color:var(--ink)}
  nav button.on svg{stroke:var(--spot)}
  nav .badge{position:absolute;top:-2px;right:calc(50% - 22px);background:var(--spot);color:#fff;font-family:var(--mono);
    font-size:10px;font-weight:800;min-width:16px;height:16px;border-radius:9px;display:none;align-items:center;justify-content:center;padding:0 4px}
  nav .badge.show{display:flex}

  /* Toast */
  #toast{
    position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);
    background:var(--ink);color:var(--card);padding:12px 18px;border-radius:24px;font-size:14px;font-weight:600;
    opacity:0;pointer-events:none;transition:.25s;z-index:50;max-width:90%;text-align:center;box-shadow:0 6px 20px rgba(0,0,0,.2)}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <div class="drop"></div>
      <div class="brand-txt">
        <h1>Atelier Stock</h1>
        <div class="sub">Suivi impression &amp; stock</div>
      </div>
    </div>
  </header>

  <main>
    <!-- ============ TRANSFORMER ============ -->
    <section id="v-make" class="view active">
      <div class="step">
        <p class="step-label"><span class="step-num">01</span> Provenance du t-shirt uni</p>
        <div class="grid" id="loc-grid"></div>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">02</span> T-shirt de base</p>
        <div class="grid" id="gram-grid"></div>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">03</span> Tailles &amp; quantités <span class="soft-note">— plusieurs possibles</span></p>
        <div class="grid" id="size-grid"></div>
        <div class="sizeqty" id="size-qty"></div>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">04</span> Couleur du t-shirt uni</p>
        <div class="grid" id="color-grid"></div>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">05</span> Personnalisation appliquée</p>
        <input type="text" id="design" placeholder="Ex : Logo Été, Client Dupont…" autocomplete="off">
        <p class="hint">Le t-shirt uni devient un produit personnalisé différent.</p>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">06</span> Technique <span class="soft-note">— DTF et/ou broderie</span></p>
        <div class="grid" id="tech-grid"></div>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">07</span> Emplacement <span class="soft-note">— optionnel</span></p>
        <input type="text" id="spot" placeholder="Ex : poitrine gauche, dos, manche…" autocomplete="off">
      </div>

      <div class="step">
        <p class="step-label">Aperçu des mouvements</p>
        <div class="ticket" id="ticket"></div>
      </div>

      <div class="step">
        <p class="step-label"><span class="step-num">08</span> Dépôt du t-shirt personnalisé <span class="soft-note">— où va le stock fini</span></p>
        <div class="grid" id="dest-grid"></div>
      </div>

      <button class="cta" id="save-btn" disabled>Enregistrer</button>
    </section>

    <!-- ============ HISTORIQUE ============ -->
    <section id="v-hist" class="view">
      <div id="hist-list"></div>
    </section>

    <!-- ============ SHOPIFY ============ -->
    <section id="v-shop" class="view">
      <div id="recap"></div>
    </section>

    <!-- ============ RÉGLAGES ============ -->
    <section id="v-set" class="view">
      <div class="set-block">
        <h3>Lieux de stock</h3>
        <div class="chips" id="set-locs"></div>
        <div class="addrow"><input type="text" id="add-loc" placeholder="Nouveau lieu"><button data-add="loc">Ajouter</button></div>
      </div>
      <div class="set-block">
        <h3>Couleurs par grammage</h3>
        <div id="set-colors"></div>
        <p class="hint">Définis les couleurs disponibles pour chaque modèle. Touche × pour en retirer une.</p>
      </div>
      <div class="set-block">
        <h3>Tailles par grammage</h3>
        <div id="set-sizes"></div>
        <p class="hint">Touche × pour retirer une taille à un modèle (ex : pas de 4XL en 220 g).</p>
      </div>
      <div class="set-block">
        <h3>Sauvegarde &amp; transfert</h3>
        <p class="hint" style="margin-top:0">Télécharge un fichier de sauvegarde (tout ton historique + réglages). Sers-t'en pour sauvegarder ou transférer vers un autre téléphone.</p>
        <div class="recap-actions" style="margin-top:12px">
          <button class="btn2" id="export-btn">Télécharger la sauvegarde</button>
          <button class="btn2" id="import-btn">Importer une sauvegarde</button>
        </div>
        <input type="file" id="import-file" accept="application/json,.json" style="display:none">
        <p class="hint" id="storage-info" style="margin-top:12px"></p>
      </div>
      <div class="set-block">
        <h3>Données</h3>
        <button class="danger" id="reset-btn">Effacer tout l'historique</button>
      </div>
    </section>
  </main>

  <nav>
    <button data-tab="make" class="on">
      <svg viewBox="0 0 24 24"><path d="M4 7l8-4 8 4-8 4-8-4z"/><path d="M4 7v10l8 4 8-4V7"/><path d="M12 11v10"/></svg>
      Transformer
    </button>
    <button data-tab="hist">
      <svg viewBox="0 0 24 24"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
      Historique
    </button>
    <button data-tab="shop">
      <span class="badge" id="nav-badge">0</span>
      <svg viewBox="0 0 24 24"><path d="M4 6h16l-1.5 12.5a2 2 0 01-2 1.5H7.5a2 2 0 01-2-1.5L4 6z"/><path d="M9 6V4.5A2.5 2.5 0 0111.5 2h1A2.5 2.5 0 0115 4.5V6"/></svg>
      Shopify
    </button>
    <button data-tab="set">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 00-.1-1.2l2-1.6-2-3.4-2.4 1a7 7 0 00-2-1.2l-.4-2.6H10.9l-.4 2.6a7 7 0 00-2 1.2l-2.4-1-2 3.4 2 1.6A7 7 0 005 12a7 7 0 00.1 1.2l-2 1.6 2 3.4 2.4-1a7 7 0 002 1.2l.4 2.6h4.2l.4-2.6a7 7 0 002-1.2l2.4 1 2-3.4-2-1.6A7 7 0 0019 12z"/></svg>
      Réglages
    </button>
  </nav>
</div>

<div id="toast"></div>

<div class="overlay" id="edit-overlay">
  <div class="sheet" id="edit-sheet"></div>
</div>

<script>
(function(){
  "use strict";
  const CFG_KEY="atelier_config", TXN_KEY="atelier_txns";
  const BASE_COLORS=["Blanc","Noir","Gris chiné","Marine","Rouge"];
  const TECHNIQUES=["DTF","Broderie"];

  const DEFAULT_CFG={
    locations:["Entrepôt","Magasin"],
    grammages:[150,180,220,280],
    colorsG:{
      150:[...BASE_COLORS],180:[...BASE_COLORS],220:[...BASE_COLORS],280:[...BASE_COLORS]
    },
    sizes:{
      150:["XXS","XS","S","M","L","XL","2XL","3XL","4XL"],
      180:["XS","S","M","L","XL","2XL"],
      220:["XS","S","M","L","XL","2XL"],
      280:["S","M","L","XL","2XL"]
    }
  };

  let cfg=structuredClone(DEFAULT_CFG);
  let txns=[];
  // current transformation draft
  let sel={loc:null,gram:null,color:null,design:"",sizeQty:{},techs:[],spot:"",destLoc:null};
  let editState=null;

  /* ---------- storage helpers ---------- */
  // Détecte l'environnement : dans Claude on utilise window.storage,
  // sinon (téléphone / navigateur autonome) on utilise le stockage local du navigateur.
  const HAS_CLAUDE = (typeof window!=="undefined" && window.storage && typeof window.storage.get==="function");
  const DB={
    async get(key){
      if(HAS_CLAUDE){ try{ const r=await window.storage.get(key,false); return (r&&r.value)?r.value:null; }catch(e){ return null; } }
      try{ return localStorage.getItem(key); }catch(e){ return null; }
    },
    async set(key,val){
      if(HAS_CLAUDE){ try{ await window.storage.set(key,val,false); }catch(e){ toast("Sauvegarde impossible"); } return; }
      try{ localStorage.setItem(key,val); }catch(e){ toast("Sauvegarde impossible"); }
    }
  };

  async function loadAll(){
    try{
      const v=await DB.get(CFG_KEY);
      if(v){
        const parsed=JSON.parse(v);
        cfg=Object.assign(structuredClone(DEFAULT_CFG),parsed);
        // migration : couleurs globales -> couleurs par grammage
        if(!parsed.colorsG){
          const base=(Array.isArray(parsed.colors)&&parsed.colors.length)?parsed.colors:BASE_COLORS;
          cfg.colorsG={};
          cfg.grammages.forEach(g=>cfg.colorsG[g]=[...base]);
        }
        cfg.grammages.forEach(g=>{ if(!Array.isArray(cfg.colorsG[g])) cfg.colorsG[g]=[...BASE_COLORS]; });
        delete cfg.colors;
      }
    }
    catch(e){ /* première utilisation */ }
    try{ const v=await DB.get(TXN_KEY); if(v) txns=JSON.parse(v); }
    catch(e){ txns=[]; }
    // migration : statut par mouvement + nouveaux champs
    txns.forEach(t=>{
      const done=t.status==="synced";
      if(t.outDone===undefined) t.outDone=done;
      if(t.inDone===undefined) t.inDone=done;
      if(!Array.isArray(t.techs)) t.techs=[];
      if(t.spot===undefined) t.spot="";
      if(t.destLoc===undefined) t.destLoc=t.loc||null;
    });
  }
  async function saveCfg(){ await DB.set(CFG_KEY,JSON.stringify(cfg)); }
  async function saveTxns(){ await DB.set(TXN_KEY,JSON.stringify(txns)); }

  /* ---------- helpers ---------- */
  const $=s=>document.querySelector(s);
  const el=(t,c,txt)=>{const n=document.createElement(t);if(c)n.className=c;if(txt!=null)n.textContent=txt;return n;};
  function toast(msg){const t=$("#toast");t.textContent=msg;t.classList.add("show");clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove("show"),2200);}
  function plainLabel(t){return `T-shirt ${t.gram} g · ${t.size} · ${t.color}`;}
  function persoLabel(t){return `« ${t.design} » · ${t.gram} g · ${t.size} · ${t.color}`;}
  function dayKey(iso){const d=new Date(iso);return d.toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long"});}
  function txStatus(t){ if(t.outDone&&t.inDone)return "synced"; if(t.outDone||t.inDone)return "partial"; return "pending"; }
  function techStr(techs){ return (techs&&techs.length)?techs.slice().sort().join("+"):""; }
  // suffixe descriptif de la perso : technique(s) + emplacement
  function persoSuffix(techs,spot){
    let s="";
    if(techs&&techs.length) s+=` · ${techs.slice().sort().join("+")}`;
    if(spot) s+=` · ${spot}`;
    return s;
  }

  /* ---------- render: TRANSFORMER ---------- */
  function renderMake(){
    // locations
    const lg=$("#loc-grid");lg.innerHTML="";
    cfg.locations.forEach(l=>{
      const b=el("button","opt wide"+(sel.loc===l?" sel":""),l);
      b.onclick=()=>{sel.loc=l;renderMake();};lg.appendChild(b);
    });
    // grammages
    const gg=$("#gram-grid");gg.innerHTML="";
    cfg.grammages.forEach(g=>{
      const b=el("button","opt spot"+(sel.gram===g?" sel":""));
      b.innerHTML=`${g}<span class="g">g</span>`;
      b.onclick=()=>{
        sel.gram=g;
        // retire tailles/couleur absentes de ce grammage
        Object.keys(sel.sizeQty).forEach(s=>{ if(!(cfg.sizes[g]||[]).includes(s)) delete sel.sizeQty[s]; });
        if(sel.color && !(cfg.colorsG[g]||[]).includes(sel.color)) sel.color=null;
        renderMake();
      };
      gg.appendChild(b);
    });
    // sizes (multi-sélection)
    const sg=$("#size-grid");sg.innerHTML="";
    if(sel.gram==null){ sg.appendChild(el("p","hint","Choisis d'abord un grammage.")); }
    else{
      (cfg.sizes[sel.gram]||[]).forEach(s=>{
        const on=sel.sizeQty[s]!=null;
        const b=el("button","opt"+(on?" sel":""),s);
        b.onclick=()=>{ if(on) delete sel.sizeQty[s]; else sel.sizeQty[s]=1; renderMake(); };
        sg.appendChild(b);
      });
    }
    // quantité par taille sélectionnée
    const sq=$("#size-qty");sq.innerHTML="";
    Object.keys(sel.sizeQty).forEach(s=>{
      const row=el("div","row");
      row.innerHTML=`<span class="sz">${s}</span>
        <div class="mini"><button type="button" data-a="m">−</button><div class="v">${sel.sizeQty[s]}</div><button type="button" data-a="p">+</button></div>
        <button type="button" class="rm" aria-label="Retirer ${s}">×</button>`;
      row.querySelector('[data-a="m"]').onclick=()=>{sel.sizeQty[s]=Math.max(1,sel.sizeQty[s]-1);renderMake();};
      row.querySelector('[data-a="p"]').onclick=()=>{sel.sizeQty[s]=sel.sizeQty[s]+1;renderMake();};
      row.querySelector('.rm').onclick=()=>{delete sel.sizeQty[s];renderMake();};
      sq.appendChild(row);
    });
    // couleurs (selon le grammage choisi)
    const cg=$("#color-grid");cg.innerHTML="";
    if(sel.gram==null){ cg.appendChild(el("p","hint","Choisis d'abord un grammage.")); }
    else{
      const cols=cfg.colorsG[sel.gram]||[];
      if(sel.color&&!cols.includes(sel.color)) sel.color=null;
      if(!cols.length) cg.appendChild(el("p","hint","Aucune couleur pour ce modèle (voir Réglages)."));
      cols.forEach(c=>{
        const b=el("button","opt"+(sel.color===c?" sel":""),c);
        b.onclick=()=>{sel.color=c;renderMake();};cg.appendChild(b);
      });
    }
    // technique(s) : DTF et/ou broderie (cumulables)
    const tg=$("#tech-grid");tg.innerHTML="";
    TECHNIQUES.forEach(tech=>{
      const on=sel.techs.includes(tech);
      const b=el("button","opt"+(on?" sel":""),tech);
      b.onclick=()=>{ sel.techs = on ? sel.techs.filter(x=>x!==tech) : [...sel.techs,tech]; renderMake(); };
      tg.appendChild(b);
    });
    // dépôt : destination du t-shirt personnalisé
    const dg=$("#dest-grid");dg.innerHTML="";
    cfg.locations.forEach(l=>{
      const b=el("button","opt wide"+(sel.destLoc===l?" sel":""),l);
      b.onclick=()=>{sel.destLoc=l;renderMake();};dg.appendChild(b);
    });
    // design + emplacement
    if($("#design").value!==sel.design) $("#design").value=sel.design;
    if($("#spot").value!==sel.spot) $("#spot").value=sel.spot;
    renderTicket();
  }

  function ready(){return sel.loc&&sel.gram&&sel.color&&sel.design.trim()&&Object.keys(sel.sizeQty).length>0&&sel.destLoc;}

  function renderTicket(){
    const t=$("#ticket");t.innerHTML="";
    const sizes=Object.keys(sel.sizeQty).sort((a,b)=>orderSize(sel.gram,a)-orderSize(sel.gram,b));
    if(!sizes.length){ t.appendChild(el("div","code","Sélectionne au moins une taille…")); $("#save-btn").disabled=true; return; }
    const g=sel.gram,co=sel.color??"—",lo=sel.loc??"—",dest=sel.destLoc??"—";
    const dz=sel.design.trim()||"personnalisation…";
    const suf=persoSuffix(sel.techs,sel.spot.trim());
    const total=sizes.reduce((n,s)=>n+sel.sizeQty[s],0);
    t.appendChild(el("div","code",`${lo.toUpperCase()} → ${dest.toUpperCase()} · ${g}g · ${co} · « ${dz} »${suf} · ${total} pièce(s)`));
    sizes.forEach(s=>{
      const q=sel.sizeQty[s];
      const row=el("div","mv");
      row.innerHTML=`<span class="sign" style="color:var(--ink)">${s}</span><span class="lbl"><span style="color:var(--spot);font-weight:700">−${q}</span> uni &nbsp;→&nbsp; <span style="color:var(--teal);font-weight:700">+${q}</span> perso</span>`;
      t.appendChild(row);
    });
    $("#save-btn").disabled=!ready();
  }
  function orderSize(g,s){const arr=cfg.sizes[g]||[];const i=arr.indexOf(s);return i<0?999:i;}

  async function saveTxn(){
    if(!ready())return;
    const batch=Date.now()+"-"+Math.random().toString(36).slice(2,6);
    const ts=new Date().toISOString();
    const sizes=Object.keys(sel.sizeQty);
    sizes.forEach(s=>{
      const q=sel.sizeQty[s]; if(q<=0)return;
      txns.push({
        id:batch+"-"+s,
        batch, ts,
        loc:sel.loc,gram:sel.gram,size:s,color:sel.color,
        qty:q,design:sel.design.trim(),
        techs:[...sel.techs],spot:sel.spot.trim(),destLoc:sel.destLoc,
        outDone:false,inDone:false
      });
    });
    await saveTxns();
    toast(sizes.length>1?`${sizes.length} mouvements enregistrés ✓`:"Mouvement enregistré ✓");
    // garde provenance / grammage / couleur / dépôt pour enchaîner, réinitialise le reste
    sel.sizeQty={};sel.design="";sel.techs=[];sel.spot="";
    renderMake();refreshBadge();
  }

  /* ---------- render: HISTORIQUE ---------- */
  function renderHist(){
    const box=$("#hist-list");box.innerHTML="";
    if(!txns.length){box.innerHTML=`<div class="empty"><div class="big">Aucune transformation</div>Enregistre ta première dans l'onglet Transformer.</div>`;return;}
    const sorted=[...txns].sort((a,b)=>b.ts.localeCompare(a.ts));
    let curDay=null;
    sorted.forEach(t=>{
      const dk=dayKey(t.ts);
      if(dk!==curDay){curDay=dk;box.appendChild(el("div","day-h",dk));}
      const card=el("div","hist");
      const time=new Date(t.ts).toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"});
      const st=txStatus(t);
      const full=t.outDone&&t.inDone;
      const pillTxt={pending:"À reporter",partial:"Partiel",synced:"Reporté"}[st];
      const meta=[];
      if(t.techs&&t.techs.length) meta.push(t.techs.slice().sort().join(" + "));
      if(t.spot) meta.push(escapeHtml(t.spot));
      const metaLine = meta.length ? `<div class="code" style="color:var(--ink);margin-top:2px">${meta.join(" · ")}</div>` : "";
      const stateLine = st==="partial"
        ? `<div class="mv-state">Shopify : sortie uni ${t.outDone?'<span class="ok">✓</span>':'○'} &nbsp;·&nbsp; entrée perso ${t.inDone?'<span class="ok">✓</span>':'○'}</div>`
        : "";
      card.innerHTML=`
        <div class="top">
          <div>
            <div class="main-lbl">« ${escapeHtml(t.design)} »</div>
            ${metaLine}
            <div class="code">${t.gram}g · ${t.size} · ${escapeHtml(t.color)} · ${escapeHtml(t.loc)} → ${escapeHtml(t.destLoc||t.loc)} · ${time}</div>
          </div>
          <span class="pill ${st}">${pillTxt}</span>
        </div>
        ${stateLine}
        <div class="foot">
          <div class="moves"><span class="o">−${t.qty} uni</span> &nbsp;→&nbsp; <span class="i">+${t.qty} perso</span></div>
          <div>
            <button class="lnk edit" data-id="${t.id}">Modifier</button>
            <button class="lnk toggle" data-id="${t.id}">${full?"Rouvrir":"Marquer reporté"}</button>
            <button class="lnk del" data-id="${t.id}">Suppr.</button>
          </div>
        </div>`;
      box.appendChild(card);
    });
    box.querySelectorAll(".toggle").forEach(b=>b.onclick=async()=>{
      const t=txns.find(x=>x.id===b.dataset.id);
      if(t){const full=t.outDone&&t.inDone;t.outDone=!full;t.inDone=!full;await saveTxns();renderHist();refreshBadge();}
    });
    box.querySelectorAll(".edit").forEach(b=>b.onclick=()=>openEdit(b.dataset.id));
    box.querySelectorAll(".del").forEach(b=>b.onclick=async()=>{
      if(confirm("Supprimer ce mouvement ?")){txns=txns.filter(x=>x.id!==b.dataset.id);await saveTxns();renderHist();refreshBadge();}
    });
  }

  /* ---------- édition d'un mouvement ---------- */
  function openEdit(id){
    const t=txns.find(x=>x.id===id); if(!t)return;
    editState={id:t.id,loc:t.loc,gram:t.gram,size:t.size,color:t.color,qty:t.qty,design:t.design,techs:[...(t.techs||[])],spot:t.spot||"",destLoc:t.destLoc||t.loc};
    $("#edit-overlay").classList.add("show");
    renderEdit();
  }
  function closeEdit(){ editState=null; $("#edit-overlay").classList.remove("show"); $("#edit-sheet").innerHTML=""; }
  function renderEdit(){
    const s=editState; if(!s)return;
    const box=$("#edit-sheet");
    box.innerHTML=`
      <h2>Modifier le mouvement</h2>
      <p class="sub2">La correction repasse ce mouvement en « À reporter ».</p>
      <div class="step"><p class="step-label">Provenance</p><div class="grid" id="e-loc"></div></div>
      <div class="step"><p class="step-label">Grammage</p><div class="grid" id="e-gram"></div></div>
      <div class="step"><p class="step-label">Taille</p><div class="grid" id="e-size"></div></div>
      <div class="step"><p class="step-label">Couleur</p><div class="grid" id="e-color"></div></div>
      <div class="step"><p class="step-label">Quantité</p>
        <div class="qty"><button type="button" id="e-minus">−</button><div class="val" id="e-qval">${s.qty}</div><button type="button" id="e-plus">+</button></div>
      </div>
      <div class="step"><p class="step-label">Personnalisation</p><input type="text" id="e-design" autocomplete="off"></div>
      <div class="step"><p class="step-label">Technique <span class="soft-note">— DTF et/ou broderie</span></p><div class="grid" id="e-tech"></div></div>
      <div class="step"><p class="step-label">Emplacement <span class="soft-note">— optionnel</span></p><input type="text" id="e-spot" autocomplete="off" placeholder="Ex : poitrine gauche, dos…"></div>
      <div class="step"><p class="step-label">Dépôt <span class="soft-note">— destination du perso</span></p><div class="grid" id="e-dest"></div></div>
      <div class="sheet-actions">
        <button class="btn2" id="e-cancel">Annuler</button>
        <button class="btn2 solid" id="e-save">Enregistrer</button>
      </div>`;
    $("#e-design").value=s.design;
    $("#e-spot").value=s.spot;
    const eloc=$("#e-loc"); cfg.locations.forEach(l=>{const b=el("button","opt wide"+(s.loc===l?" sel":""),l);b.onclick=()=>{s.loc=l;renderEdit();};eloc.appendChild(b);});
    const egram=$("#e-gram"); cfg.grammages.forEach(g=>{const b=el("button","opt spot"+(s.gram===g?" sel":""));b.innerHTML=`${g}<span class="g">g</span>`;b.onclick=()=>{s.gram=g;if(!(cfg.sizes[g]||[]).includes(s.size))s.size=(cfg.sizes[g]||[])[0]||null;if(!(cfg.colorsG[g]||[]).includes(s.color))s.color=(cfg.colorsG[g]||[])[0]||null;renderEdit();};egram.appendChild(b);});
    const esize=$("#e-size"); (cfg.sizes[s.gram]||[]).forEach(sz=>{const b=el("button","opt"+(s.size===sz?" sel":""),sz);b.onclick=()=>{s.size=sz;renderEdit();};esize.appendChild(b);});
    const ecol=$("#e-color"); (cfg.colorsG[s.gram]||[]).forEach(c=>{const b=el("button","opt"+(s.color===c?" sel":""),c);b.onclick=()=>{s.color=c;renderEdit();};ecol.appendChild(b);});
    const etech=$("#e-tech"); TECHNIQUES.forEach(tech=>{const on=s.techs.includes(tech);const b=el("button","opt"+(on?" sel":""),tech);b.onclick=()=>{s.techs=on?s.techs.filter(x=>x!==tech):[...s.techs,tech];renderEdit();};etech.appendChild(b);});
    const edest=$("#e-dest"); cfg.locations.forEach(l=>{const b=el("button","opt wide"+(s.destLoc===l?" sel":""),l);b.onclick=()=>{s.destLoc=l;renderEdit();};edest.appendChild(b);});
    $("#e-minus").onclick=()=>{s.qty=Math.max(1,s.qty-1);$("#e-qval").textContent=s.qty;};
    $("#e-plus").onclick=()=>{s.qty=s.qty+1;$("#e-qval").textContent=s.qty;};
    $("#e-design").oninput=e=>{s.design=e.target.value;};
    $("#e-spot").oninput=e=>{s.spot=e.target.value;};
    $("#e-cancel").onclick=closeEdit;
    $("#e-save").onclick=saveEdit;
  }
  async function saveEdit(){
    const s=editState; if(!s)return;
    if(!s.loc||!s.gram||!s.size||!s.color||!String(s.design).trim()||s.qty<1){toast("Complète tous les champs");return;}
    const t=txns.find(x=>x.id===s.id); if(!t){closeEdit();return;}
    t.loc=s.loc;t.gram=s.gram;t.size=s.size;t.color=s.color;t.qty=s.qty;t.design=String(s.design).trim();
    t.techs=[...s.techs];t.spot=String(s.spot||"").trim();
    t.outDone=false;t.inDone=false;
    await saveTxns();closeEdit();renderHist();refreshBadge();toast("Mouvement modifié ✓");
  }

  /* ---------- render: SHOPIFY RECAP ---------- */
  function aggregate(){
    const outs={},ins={};
    txns.forEach(t=>{
      if(!t.outDone){
        const k=[t.loc,t.gram,t.size,t.color].join("¦");
        const g=outs[k]||(outs[k]={loc:t.loc,gram:t.gram,size:t.size,color:t.color,qty:0,ids:[]});
        g.qty+=t.qty; g.ids.push(t.id);
      }
      if(!t.inDone){
        const tstr=techStr(t.techs);
        const k=[t.destLoc||"",t.design,tstr,t.spot||"",t.gram,t.size,t.color].join("¦");
        const g=ins[k]||(ins[k]={destLoc:t.destLoc||"",design:t.design,techs:t.techs||[],spot:t.spot||"",gram:t.gram,size:t.size,color:t.color,qty:0,ids:[]});
        g.qty+=t.qty; g.ids.push(t.id);
      }
    });
    return {outs:Object.values(outs),ins:Object.values(ins)};
  }

  function renderRecap(){
    const box=$("#recap");box.innerHTML="";
    const {outs,ins}=aggregate();
    if(!outs.length&&!ins.length){box.innerHTML=`<div class="empty"><div class="big">Rien à reporter</div>Toutes les transformations sont à jour dans Shopify.</div>`;return;}

    const info=el("p","hint","Coche chaque ligne au fur et à mesure que tu la reportes dans Shopify. Une ligne cochée disparaît quand tu reviens sur cet onglet.");
    info.style.margin="0 2px 16px";box.appendChild(info);

    // crée une ligne cochable ; le clic bascule le mouvement (sans re-render, pour pouvoir décocher)
    function mkLine(inner,ids,flag){
      const line=el("div","recap-line");
      line.innerHTML=`<div class="check"></div>${inner}`;
      line.onclick=async()=>{
        const done=!line.classList.contains("done");
        ids.forEach(id=>{const t=txns.find(x=>x.id===id);if(t)t[flag]=done;});
        line.classList.toggle("done",done);
        await saveTxns();refreshBadge();
      };
      return line;
    }

    if(outs.length){
      const secOut=el("div","sec out");
      secOut.innerHTML=`<div class="sec-h"><span class="tag">SORTIES</span> Stock à retirer (t-shirts unis)</div>`;
      outs.sort(sortLbl).forEach(t=>{
        secOut.appendChild(mkLine(
          `<div class="lbl">T-shirt ${t.gram} g · ${t.size} · ${escapeHtml(t.color)}<small>Lieu : ${escapeHtml(t.loc)}</small></div><div class="num">−${t.qty}</div>`,
          t.ids,"outDone"));
      });
      box.appendChild(secOut);
    }

    if(ins.length){
      const secIn=el("div","sec in");
      secIn.innerHTML=`<div class="sec-h"><span class="tag">ENTRÉES</span> Stock à ajouter (t-shirts perso)</div>`;
      ins.sort(sortLbl).forEach(t=>{
        const suf=[];
        if(t.techs&&t.techs.length) suf.push(escapeHtml(t.techs.slice().sort().join("+")));
        if(t.spot) suf.push(escapeHtml(t.spot));
        const sufTxt=suf.length?` · ${suf.join(" · ")}`:"";
        secIn.appendChild(mkLine(
          `<div class="lbl">« ${escapeHtml(t.design)} »${sufTxt} · ${t.gram} g · ${t.size} · ${escapeHtml(t.color)}<small>Dépôt : ${escapeHtml(t.destLoc||"—")}</small></div><div class="num">+${t.qty}</div>`,
          t.ids,"inDone"));
      });
      box.appendChild(secIn);
    }

    const actions=el("div","recap-actions");
    const copyB=el("button","btn2","Copier le récap");
    copyB.onclick=()=>copyRecap(outs,ins);
    const doneB=el("button","btn2 solid","Tout marquer comme reporté");
    doneB.onclick=async()=>{
      if(!confirm("Marquer TOUS les mouvements comme reportés dans Shopify ?"))return;
      txns.forEach(t=>{t.outDone=true;t.inDone=true;});
      await saveTxns();renderRecap();refreshBadge();toast("Tout est reporté ✓");
    };
    actions.appendChild(copyB);actions.appendChild(doneB);
    box.appendChild(actions);
  }
  function sortLbl(a,b){return (a.gram-b.gram)||String(a.size).localeCompare(b.size);}

  function copyRecap(outs,ins){
    const d=new Date().toLocaleString("fr-FR");
    let txt=`RÉCAP À REPORTER DANS SHOPIFY — ${d}\n\nSORTIES (retirer du stock)\n`;
    outs.sort(sortLbl).forEach(t=>{txt+=`- ${t.loc} · T-shirt ${t.gram} g · ${t.size} · ${t.color} : −${t.qty}\n`;});
    txt+=`\nENTRÉES (ajouter au stock)\n`;
    ins.sort(sortLbl).forEach(t=>{
      const suf=persoSuffix(t.techs,t.spot);
      txt+=`- [${t.destLoc||"—"}] « ${t.design} »${suf} · ${t.gram} g · ${t.size} · ${t.color} : +${t.qty}\n`;
    });
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(txt).then(()=>toast("Récap copié ✓")).catch(()=>fallbackCopy(txt));
    }else fallbackCopy(txt);
  }
  function fallbackCopy(txt){
    const ta=document.createElement("textarea");ta.value=txt;ta.style.position="fixed";ta.style.opacity="0";
    document.body.appendChild(ta);ta.select();
    try{document.execCommand("copy");toast("Récap copié ✓");}catch(e){toast("Copie impossible");}
    document.body.removeChild(ta);
  }

  /* ---------- render: RÉGLAGES ---------- */
  function renderSet(){
    // locations
    const lc=$("#set-locs");lc.innerHTML="";
    cfg.locations.forEach(l=>lc.appendChild(chip(l,()=>{cfg.locations=cfg.locations.filter(x=>x!==l);if(sel.loc===l)sel.loc=null;saveCfg();renderSet();renderMake();})));
    // couleurs par grammage : puces supprimables + ajout
    const cc=$("#set-colors");cc.innerHTML="";
    cfg.grammages.forEach(g=>{
      const row=el("div","size-row");
      row.appendChild(el("label",null,`${g} g`));
      const chips=el("div","chips");
      (cfg.colorsG[g]||[]).forEach(c=>{
        chips.appendChild(chip(c,()=>{
          cfg.colorsG[g]=(cfg.colorsG[g]||[]).filter(x=>x!==c);
          if(sel.gram===g && sel.color===c) sel.color=null;
          saveCfg();renderSet();renderMake();
        }));
      });
      if(!(cfg.colorsG[g]||[]).length) chips.appendChild(el("span","hint","Aucune couleur."));
      row.appendChild(chips);
      const add=el("div","addrow");
      const inp=el("input");inp.type="text";inp.placeholder="Ajouter une couleur";
      const btn=el("button",null,"Ajouter");
      btn.onclick=()=>{
        const v=inp.value.trim();if(!v)return;
        cfg.colorsG[g]=cfg.colorsG[g]||[];
        if(!cfg.colorsG[g].includes(v))cfg.colorsG[g].push(v);
        inp.value="";saveCfg();renderSet();renderMake();toast("Couleur ajoutée ✓");
      };
      add.appendChild(inp);add.appendChild(btn);
      row.appendChild(add);
      cc.appendChild(row);
    });
    // tailles par grammage : puces supprimables + ajout
    const sz=$("#set-sizes");sz.innerHTML="";
    cfg.grammages.forEach(g=>{
      const row=el("div","size-row");
      row.appendChild(el("label",null,`${g} g`));
      const chips=el("div","chips");
      (cfg.sizes[g]||[]).forEach(s=>{
        chips.appendChild(chip(s,()=>{
          cfg.sizes[g]=(cfg.sizes[g]||[]).filter(x=>x!==s);
          delete sel.sizeQty[s];
          saveCfg();renderSet();renderMake();
        }));
      });
      if(!(cfg.sizes[g]||[]).length) chips.appendChild(el("span","hint","Aucune taille."));
      row.appendChild(chips);
      const add=el("div","addrow");
      const inp=el("input");inp.type="text";inp.placeholder="Ajouter une taille";
      const btn=el("button",null,"Ajouter");
      btn.onclick=()=>{
        const v=inp.value.trim().toUpperCase();if(!v)return;
        cfg.sizes[g]=cfg.sizes[g]||[];
        if(!cfg.sizes[g].includes(v))cfg.sizes[g].push(v);
        inp.value="";saveCfg();renderSet();renderMake();toast("Taille ajoutée ✓");
      };
      add.appendChild(inp);add.appendChild(btn);
      row.appendChild(add);
      sz.appendChild(row);
    });
  }
  function chip(label,onDel){
    const c=el("span","chip");c.appendChild(document.createTextNode(label));
    const b=el("button",null,"×");b.setAttribute("aria-label","Supprimer "+label);b.onclick=onDel;c.appendChild(b);return c;
  }

  /* ---------- badge + nav ---------- */
  function refreshBadge(){
    const n=txns.filter(t=>!(t.outDone&&t.inDone)).length;
    const b=$("#nav-badge");b.textContent=n;b.classList.toggle("show",n>0);
  }
  function switchTab(tab){
    document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
    document.querySelectorAll("nav button").forEach(b=>b.classList.remove("on"));
    ({make:"#v-make",hist:"#v-hist",shop:"#v-shop",set:"#v-set"})[tab] && $(({make:"#v-make",hist:"#v-hist",shop:"#v-shop",set:"#v-set"})[tab]).classList.add("active");
    document.querySelector(`nav button[data-tab="${tab}"]`).classList.add("on");
    if(tab==="hist")renderHist();
    if(tab==="shop")renderRecap();
    if(tab==="set")renderSet();
    window.scrollTo(0,0);
  }

  function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}

  /* ---------- events ---------- */
  function bind(){
    $("#design").oninput=e=>{sel.design=e.target.value;renderTicket();};
    $("#save-btn").onclick=saveTxn;
    $("#edit-overlay").onclick=e=>{ if(e.target.id==="edit-overlay") closeEdit(); };
    document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));
    document.querySelectorAll("[data-add]").forEach(b=>b.onclick=async()=>{
      const type=b.dataset.add;
      if(type!=="loc")return;
      const inp=$("#add-loc");
      const v=inp.value.trim();if(!v)return;
      if(!cfg.locations.includes(v))cfg.locations.push(v);
      inp.value="";await saveCfg();renderSet();renderMake();toast("Ajouté ✓");
    });
    $("#reset-btn").onclick=async()=>{
      if(confirm("Effacer DÉFINITIVEMENT tout l'historique des transformations ?")){
        txns=[];await saveTxns();renderHist();renderRecap();refreshBadge();toast("Historique effacé");
      }
    };
    $("#export-btn").onclick=exportData;
    $("#import-btn").onclick=()=>$("#import-file").click();
    $("#import-file").onchange=importData;
  }

  /* ---------- sauvegarde / restauration ---------- */
  function exportData(){
    const payload={app:"atelier-stock",version:1,exportedAt:new Date().toISOString(),config:cfg,txns:txns};
    const stamp=new Date().toISOString().slice(0,16).replace(/[:T]/g,"-");
    const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    a.href=url;a.download=`atelier-stock-${stamp}.json`;
    document.body.appendChild(a);a.click();
    setTimeout(()=>{URL.revokeObjectURL(url);a.remove();},1000);
    toast("Sauvegarde téléchargée ✓");
  }
  function importData(e){
    const file=e.target.files&&e.target.files[0]; if(!file)return;
    const reader=new FileReader();
    reader.onload=async()=>{
      try{
        const data=JSON.parse(reader.result);
        if(!data||!Array.isArray(data.txns)) throw new Error("format");
        if(!confirm(`Importer cette sauvegarde ?\n${data.txns.length} mouvement(s).\nCela remplace les données de CE téléphone.`)){e.target.value="";return;}
        if(data.config) cfg=Object.assign(structuredClone(DEFAULT_CFG),data.config);
        txns=data.txns.map(t=>{const done=t.status==="synced";return Object.assign({},t,{outDone:t.outDone!==undefined?t.outDone:done,inDone:t.inDone!==undefined?t.inDone:done});});
        await saveCfg();await saveTxns();
        renderMake();renderHist();renderRecap();renderSet();refreshBadge();
        toast("Sauvegarde importée ✓");
      }catch(err){ toast("Fichier invalide"); }
      e.target.value="";
    };
    reader.onerror=()=>{toast("Lecture impossible");e.target.value="";};
    reader.readAsText(file);
  }

  /* ---------- init ---------- */
  (async function init(){
    await loadAll();
    bind();
    renderMake();
    refreshBadge();
    const info=$("#storage-info");
    if(info) info.textContent = HAS_CLAUDE
      ? "Stockage : compte Claude (privé, synchronisé sur tes appareils Claude)."
      : "Stockage : ce navigateur uniquement. Les données restent sur ce téléphone. Utilise la sauvegarde pour les transférer.";
  })();
})();
</script>
</body>
</html>
